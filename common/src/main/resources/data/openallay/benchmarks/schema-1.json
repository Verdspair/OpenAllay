{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openallay.dev/schema/benchmark-1.json",
  "title": "OpenAllay benchmark corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "prompt", "attempts", "maxModelTurns", "verifier"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "attempts": {"type": "integer", "minimum": 1},
          "maxModelTurns": {"type": "integer", "minimum": 1},
          "verifier": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": [
                  "JSON_PATH_EQUALS",
                  "RESULT_CONTAINS",
                  "EFFECT_CONTAINS",
                  "NON_EMPTY_RESULT"
                ]
              },
              "path": {"type": "string"},
              "expected": {},
              "contains": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
